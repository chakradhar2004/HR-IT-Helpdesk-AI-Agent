# ==========================================
# LLM Provider Configuration (Choose one)
# ==========================================
# Default: Google Gemini (gemini-2.5-flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative Providers (Optional fallback)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM Model Configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.1

# ==========================================
# PostgreSQL Database Configuration
# ==========================================
# Note: If PostgreSQL container is not running, the application
# automatically falls back to SQLite populated with db/init.sql.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hr_it_helpdesk
DB_USER=helpdesk_user
DB_PASSWORD=helpdesk_pass

# ==========================================
# Vector Store / RAG Configuration
# ==========================================
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
